{
  "name": "cryptlings-night-shift-tests",
  "tree": {
    "$className": "DataModel",
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      },
      "TestBootstrap": {
        "$path": "tests/roblox/TestBootstrap.server.luau"
      }
    },
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Packages": {
        "$path": {
          "optional": "Packages"
        }
      },
      "DevPackages": {
        "$path": "DevPackages"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    }
  }
}
